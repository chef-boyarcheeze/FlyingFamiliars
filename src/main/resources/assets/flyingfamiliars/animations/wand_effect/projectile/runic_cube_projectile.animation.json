{
	"format_version": "1.8.0",
	"animations": {
		"animation.runic_cube_projectile.idle": {
			"loop": true,
			"bones": {
				"body": {
					"rotation": {
						"vector": ["-120 * query.anim_time", "-120 * query.anim_time", 0]
					}
				}
			}
		},
		"animation.runic_cube_projectile.death": {
			"loop": "hold_on_last_frame",
			"animation_length": 0.5,
			"bones": {
				"body": {
					"scale": {
						"0.0": {
							"vector": [1, 1, 1]
						},
						"0.5": {
							"vector": [0, 0, 0],
							"easing": "easeInBack"
						}
					}
				}
			}
		}
	},
	"geckolib_format_version": 2
}